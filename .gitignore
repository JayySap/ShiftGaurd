# ===================
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ===================
# Type Checking
# ===================
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

