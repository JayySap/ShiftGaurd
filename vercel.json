{
  "version": 2,
  "builds": [
    {
      "src": "src/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/cron/generate_schedule.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/cron/generate-schedule",
      "dest": "api/cron/generate_schedule.py"
    },
    {
      "src": "/(.*)",
      "dest": "src/app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-schedule",
      "schedule": "0 1 * * 6"
    }
  ]
}
