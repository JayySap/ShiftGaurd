# ShiftGuard Environment Configuration
# Copy this file to .env and fill in your values

# ===================
# DATABASE (Required)
# ===================
# Neon Postgres connection string
# Format: postgres://user:password@host/database?sslmode=require
DATABASE_URL=postgres://user:password@your-neon-project.neon.tech/shiftguard?sslmode=require

# ===================
# FLASK (Required)
# ===================
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-in-production-use-secrets-token-hex

# Environment: development, production, testing
FLASK_ENV=development

# Enable debug mode (set to False in production)
FLASK_DEBUG=True

# ===================
# COMPOSIO (Optional)
# ===================
# API key for Google Calendar integration
# Get from: https://app.composio.dev
COMPOSIO_API_KEY=

# ===================
# GOOGLE CALENDAR (Optional)
# ===================
# Target calendar ID (use "primary" for the default calendar)
GOOGLE_CALENDAR_ID=primary

# ===================
# COMPLIANCE SETTINGS
# ===================
# Default timezone for shift calculations
DEFAULT_TIMEZONE=America/Toronto

# Minimum rest hours between shifts (labor law compliance)
MIN_REST_HOURS=8

# Minimum consecutive hours off per week
WEEKLY_REST_HOURS=32

# Default maximum weekly hours per employee
MAX_WEEKLY_HOURS=40
